# Ajustes de internet-check: /etc/internet-check/config.env
# (las credenciales del bot van aparte, en /etc/internet-check/bot.env)

#DEVICE_NAME=orangepi-casa
#CHECK_INTERVAL=10
#FAIL_THRESHOLD=3
#CHECK_HOSTS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53
#CHECK_TIMEOUT=3           # segundos de espera por destino
#SPEEDTEST_STREAMS=4       # conexiones paralelas del test de velocidad
#WOL_BROADCAST=255.255.255.255   # difusión del paquete Wake-on-LAN
#SPEEDTEST_SECONDS=8      # duración de bajada y de subida en el test
#SPEEDTEST_EVERY_HOURS=6   # test de velocidad programado (0 = desactivado)
#SPEED_MIN_DOWN_MBPS=0     # avisa si la bajada queda por debajo (0 = sin aviso)
#IP_CHECK_MINUTES=5        # avisa si cambia la IP pública (0 = desactivado)
#LAN_SCAN_MINUTES=10       # avisa de dispositivos nuevos en la red (0 = desactivado)
#LAN_CIDR=192.168.1.0/24   # por defecto, la /24 de la interfaz principal
#WOL_DEVICES=PC=AA:BB:CC:DD:EE:FF,NAS=11:22:33:44:55:66   # equipos para Wake-on-LAN
#REBOOT_ENABLED=1         # permite reiniciar la Pi desde el bot (0 = desactivado)
#SPEEDTEST_SERVERS=https://fra.speedtest.clouvider.net/backend,https://lon.speedtest.clouvider.net/backend   # backends LibreSpeed, por orden
#QUALITY_INTERVAL=60       # segundos entre medidas de latencia, pérdida y DNS (0 = desactivado)
#QUALITY_PROBES=10         # conexiones de prueba por medida
#QUALITY_LOSS_ALERT=10     # % de pérdida que se considera conexión degradada
#QUALITY_RTT_ALERT=300     # ms de latencia que se considera conexión degradada
#QUALITY_ALERT_BURSTS=3    # medidas seguidas para avisar (y para dar por recuperada)
#HEALTH_MINUTES=5          # minutos entre lecturas de temperatura, memoria y disco (0 = desactivado)
#HEALTH_TEMP_ALERT=75      # °C de CPU a partir de los que se avisa
#HEALTH_DISK_ALERT=90      # % de disco usado a partir del que se avisa
#HEALTH_MEM_ALERT=90       # % de memoria usada a partir del que se avisa
#RETENTION_DAYS=30         # días que se conservan las medidas de calidad y salud
#REPORT_DAILY_TIME=08:00   # hora del informe diario, hora local de la Pi ("off" = desactivado)
#REPORT_WEEKLY_DAY=mon     # día en que el informe diario pasa a ser semanal (mon..sun, "off" = nunca)
