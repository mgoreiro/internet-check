# Genera docs/demo.gif (necesita vhs):
#   python3 docs/demo-seed.py && vhs docs/demo.tape
Output docs/demo.gif
Set Shell "bash"
Set FontSize 16
Set Width 1200
Set Height 700
Set Padding 12
Set TypingSpeed 60ms

Hide
Type "cd ~ && PS1='$ ' && clear" Enter
Sleep 1s
Type "$OLDPWD/docs/demo-run.sh" Enter
Sleep 2s
Show

Sleep 2s
Down Down Down
Sleep 500ms
Enter
Sleep 3s
Escape
Sleep 500ms
Down
Enter
Sleep 3s
Escape
Sleep 500ms
Type "m"
Sleep 800ms
Right Right Right Right
Sleep 800ms
Down
Sleep 800ms
Enter
Sleep 4s
Escape
Sleep 1s
Type "q"
Sleep 1s
