# Ajustes de internet-check para OpenWrt: /etc/internet-check/config.env
# (las credenciales del bot van aparte, en bot.env). Se aplican con: /etc/init.d/internet-check restart

#DEVICE_NAME=ER-X
#CHECK_INTERVAL=10         # segundos entre comprobaciones
#FAIL_THRESHOLD=3          # fallos seguidos para dar la conexión por caída
#CHECK_HOSTS=1.1.1.1:53,8.8.8.8:53,9.9.9.9:53
#CHECK_TIMEOUT=3

# La LAN NO se deduce sola en un router (la ruta por defecto es la WAN): indica la tuya
#LAN_CIDR=192.168.1.0/24
#LAN_SCAN_MINUTES=10       # avisa de dispositivos nuevos en la red (0 = desactivado)
#IP_CHECK_MINUTES=5        # avisa si cambia la IP pública (0 = desactivado)
#WOL_DEVICES=PC=AA:BB:CC:DD:EE:FF,NAS=11:22:33:44:55:66
#REBOOT_ENABLED=1          # permite reiniciar el router desde el bot (0 = desactivado)

# Test de velocidad (a mano, con /velocidad). El TLS consume mucha CPU en un ER-X: con 2 conexiones
# suele medir unos 50-100 Mbps como máximo; no es la velocidad real de la línea si es mayor.
#SPEEDTEST_STREAMS=2
#SPEEDTEST_SECONDS=8

#QUALITY_INTERVAL=60       # segundos entre medidas de latencia, pérdida y DNS (0 = desactivado)
#QUALITY_PROBES=10
#QUALITY_LOSS_ALERT=10
#QUALITY_RTT_ALERT=300
#QUALITY_ALERT_BURSTS=3
#HEALTH_MINUTES=5          # minutos entre lecturas de carga, memoria y flash (0 = desactivado)
#HEALTH_MEM_ALERT=90
#HEALTH_DISK_ALERT=90

# Vigilar equipos y servicios: Nombre=destino separados por comas (host:puerto, ping://host o URL)
#WATCH_TARGETS=NAS=192.168.1.50:5000,PC=ping://192.168.1.20,Web=https://example.com
#WATCH_INTERVAL=60
#WATCH_FAILS=3

# Presencia: Nombre=MAC separados por comas (los móviles deben usar su MAC fija en esa wifi)
#PRESENCE=Ana=AA:BB:CC:DD:EE:FF
#PRESENCE_MISSES=3

# Modo no molestar: horario fijo (también hay modo manual con /silencio 8)
#QUIET_HOURS=23:00-07:00

# Latido: alarma de «se ha caído la conexión» mientras está caída (Healthchecks.io, Uptime Kuma...)
#HEARTBEAT_URL=https://hc-ping.com/tu-codigo-secreto
#HEARTBEAT_SECONDS=60
