#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# Servicio procd de internet-check para OpenWrt. procd lo relanza si Python se cae.
START=95
STOP=10
USE_PROCD=1
DIR=/etc/internet-check

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/python3 "$DIR/monitor.py"
    procd_set_param env INTERNET_CHECK_DIR="$DIR" PYTHONDONTWRITEBYTECODE=1
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_close_instance
}
