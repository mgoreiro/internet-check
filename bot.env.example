# Credenciales del bot de Telegram (fichero secreto: permisos 600, solo root)
# Se crea en /etc/internet-check/bot.env
TELEGRAM_TOKEN=123456:ABC-tu-token-de-BotFather
# Administrador principal: puede todo y recibe los avisos
TELEGRAM_CHAT_ID=123456789

# Opcionales (ids de chat separados por comas; un grupo tiene un id negativo)
#TELEGRAM_ADMINS=111111111          # más administradores
#TELEGRAM_VIEWERS=222222222,-100333 # solo consulta: no pueden reiniciar ni encender equipos
#TELEGRAM_NOTIFY_VIEWERS=1          # copiar a todos los avisos importantes (caídas, degradación, DNS)
